<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TimKiemForm</class>

 <widget class="QWidget" name="TimKiemForm">

  <layout class="QVBoxLayout" name="mainLayout">

   <!-- ================= SEARCH BAR ================= -->
   <item>
    <layout class="QHBoxLayout" name="searchLayout">

     <item>
      <widget class="QLabel" name="lblSearchTitle">
