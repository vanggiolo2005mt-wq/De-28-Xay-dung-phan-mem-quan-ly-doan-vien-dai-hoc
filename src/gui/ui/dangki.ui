 <property name="styleSheet">
  <string>
QWidget {
    background-color: rgba(0, 0, 0, 120);
}

/* CARD */
QFrame {
    background: white;
    border-radius: 12px;
    padding: 20px;
}

/* TITLE */
QLabel#lblTitle {
    font-size: 18px;
    font-weight: bold;
}

/* INPUT */
QLineEdit {
    padding: 8px;
    border: 1px solid #ccc;
    border-radius: 6px;
}

/* BUTTON */
QPushButton {
    background-color: #3498db;
    color: white;
    border-radius: 6px;
    height: 35px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2980b9;
}

/* BACK BUTTON */
QPushButton#btnBackLogin {
    background: transparent;
    color: #3498db;
    border: none;
}
  </string>
 </property>

 <layout class="QVBoxLayout">

