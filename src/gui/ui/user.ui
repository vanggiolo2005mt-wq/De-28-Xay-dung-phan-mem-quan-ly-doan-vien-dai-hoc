    <item>
     <widget class="QLineEdit" name="txtSearch">
      <property name="placeholderText">
       <string>Tìm kiếm username...</string>
      </property>
     </widget>
    </item>

    <item>
     <widget class="QPushButton" name="btnSearch">
      <property name="text"><string>🔍 Tìm</string></property>
     </widget>
    </item>

   </layout>
