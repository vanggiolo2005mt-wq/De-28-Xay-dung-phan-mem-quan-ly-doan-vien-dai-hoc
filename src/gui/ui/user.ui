     <string>👤 QUẢN LÝ TÀI KHOẢN</string>
    </property>
    <property name="alignment">
     <set>Qt::AlignCenter</set>
    </property>
   </widget>
  </item>

  <!-- ===== FORM ===== -->
  <item>
   <widget class="QFrame">
    <layout class="QGridLayout">

