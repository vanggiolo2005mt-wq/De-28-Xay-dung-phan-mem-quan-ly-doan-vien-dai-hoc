<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
<class>UserForm</class>

<widget class="QWidget" name="UserForm">

 <property name="styleSheet">
  <string>

QWidget {
    background-color: #f5f7fa;
    font-family: Segoe UI;
}

/* TITLE */
QLabel#lblTitle {
    font-size: 20px;
    font-weight: bold;
    color: #2c3e50;
}

/* CARD */
QFrame {
    background-color: white;
    border-radius: 12px;
    border: 1px solid #ddd;
}

/* INPUT */
QLineEdit, QComboBox {
    padding: 6px;
    border-radius: 6px;
    border: 1px solid #ccc;
}

/* BUTTON */
QPushButton {
    padding: 8px;
    border-radius: 6px;
    font-weight: bold;
}

QPushButton#btnAdd {
    background-color: #27ae60;
    color: white;
}
QPushButton#btnAdd:hover { background-color: #219150; }

QPushButton#btnUpdate {
    background-color: #f39c12;
    color: white;
}
QPushButton#btnUpdate:hover { background-color: #d68910; }

QPushButton#btnDelete {
    background-color: #e74c3c;
    color: white;
}
QPushButton#btnDelete:hover { background-color: #c0392b; }

QPushButton#btnRefresh {
    background-color: #3498db;
    color: white;
}
QPushButton#btnRefresh:hover { background-color: #2980b9; }

/* TABLE */
QTableWidget {
    background-color: white;
    border-radius: 8px;
    border: 1px solid #ddd;
}

QHeaderView::section {
    background-color: #ecf0f1;
    padding: 6px;
    font-weight: bold;
    border: none;
}

  </string>
 </property>

 <layout class="QVBoxLayout">

  <!-- ===== TITLE ===== -->
  <item>
   <widget class="QLabel" name="lblTitle">
